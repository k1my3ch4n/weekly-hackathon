{
  "name": "bndl-care",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "cli",
    "report-ui"
  ],
  "scripts": {
    "build:ui": "npm run build --workspace=report-ui",
    "build:cli": "npm run build --workspace=cli",
